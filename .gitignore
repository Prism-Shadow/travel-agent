.DS_Store

# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
# browser-extension E2E/build writes port-scoped dirs (dist-19989, dist-packaged)
# that the `dist/` rule above does not match. Recreated on test/build; do not commit.
packages/browser-extension/dist-*/
# web assets copied into the server package at npm publish time
packages/server/web-dist/

# secrets / local config
.env
.env.*
!.env.example

# agenthub trace cache
cache/

# legacy .penguin workspace symlink (no longer created; ignored for old working copies)
.penguin

# logs
*.log

# claude code session state (worktrees, skills)
.claude/

# playwright e2e artifacts
packages/web/test-results/
packages/web/playwright-report/

# JUnit reports: CI asks for one so a failure's diff survives the log, and running that same
# command locally leaves the file behind.
browser-cli-results.xml

# blog images staged locally by the landing capture/render scripts, then uploaded to
# the community repo's blog-assets/ — never committed here (see lib/links.ts)
packages/landing/.blog-assets/

# Upstream ignored /design (a symlink to a separate private repo there) and both agent instruction
# files. travel-agent diverges on two of the three:
#
#   - /design is gone entirely: the numbered design records moved to docs/design/ on 2026-08-19, so
#     there is no root design/ left to ignore or re-include.
#   - AGENTS.md is tracked. Upstream treats it as per-developer local configuration; here it states
#     the product direction, the non-negotiable rules and the division of labour between the docs,
#     which is repository knowledge and useless if it only exists on one machine.
#   - CLAUDE.md stays ignored — that one really is per-developer, and this repo's own is at ~/.
/CLAUDE.md

# Generated by the browser-cli suite, not fixtures. They come out of whatever Chromium happens to be
# installed — locally that is a substituted build, not the pinned revision — so committing them
# would bake a wrong baseline into the repo. See docs/verification/phase-00.md §6.
packages/browser-cli/test/aria-snapshots/
packages/browser-cli/src/snapshots/
packages/browser-cli/test-results/
packages/browser-cli/tmp/

# Raw web-research scrapes (firecrawl CLI cache; findings live in docs/research/)
.firecrawl/

# Linked git worktrees (see AGENTS.md § Worktrees): task checkouts, never committed
.worktree/

# design-QA captures and other binary scratch (regenerated on demand, never product)
artifacts/
