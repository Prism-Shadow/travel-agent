{
  // Typecheck for test/. The main tsconfig emits from src/ only (rootDir: src), so tests
  // cannot join it without shipping in the build; before this config existed they were
  // typechecked by nothing at all — vitest does not check types. Checks src and test
  // together without emitting. Mirrors packages/browser-cli/tsconfig.test.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "test"]
}
