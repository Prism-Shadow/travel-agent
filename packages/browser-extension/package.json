{
  "name": "penguin-browser-extension",
  "version": "0.0.99",
  "description": "Penguin Browser Chrome extension for Playwright and PenguinHarness",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc --project . && vite build --config vite.config.mts && tsx scripts/copy-prism.ts",
    "typecheck": "tsc --project . --noEmit",
    "reload": "pnpm build && open -a 'Google Chrome' 'chrome://extensions/'",
    "watch": "vite build --watch --config vite.config.mts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.315",
    "concurrently": "^8.2.2",
    "typescript": "^5.8.2",
    "vite": "^8.0.13",
    "vite-plugin-static-copy": "^3.1.1"
  },
  "dependencies": {
    "penguin-browser": "workspace:^",
    "string-dedent": "^3.0.2",
    "zustand": "^5.0.8"
  }
}
