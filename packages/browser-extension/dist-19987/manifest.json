{
  "manifest_version": 3,
  "name": "Penguin Browser",
  "version": "0.0.107",
  "key": "",
  "description": "Control explicitly authorized Chrome tabs through Penguin Browser, Playwright, and PenguinHarness.",
  "permissions": [
    "debugger",
    "scripting",
    "tabGroups",
    "contextMenus",
    "tabs",
    "tabCapture",
    "offscreen",
    "storage",
    "identity",
    "identity.email",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Attach Penguin Browser to this tab",
    "default_icon": {
      "16": "icons/penguin-browser-16.png",
      "32": "icons/penguin-browser-32.png",
      "48": "icons/penguin-browser-48.png",
      "128": "icons/penguin-browser-128.png"
    }
  },
  "icons": {
    "16": "icons/penguin-browser-16.png",
    "32": "icons/penguin-browser-32.png",
    "48": "icons/penguin-browser-48.png",
    "128": "icons/penguin-browser-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/penguin-browser-icon-black.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}