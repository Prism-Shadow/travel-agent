{
  // Type-check tests and scripts without emitting them.
  //
  // The main tsconfig includes only `src` because it emits to `dist`. Keeping tests under `src`
  // used to compile and publish 88 `.test.js` files (`files` includes both `dist` and `src`). Moving
  // them to `test/` fixed publication but also removed them from tsc's view; Vitest does not
  // type-check them, so test type errors would otherwise pass silently.
  //
  // Type-checking therefore runs in two passes: the main config emits `src`, while this config
  // covers source, tests, and scripts without emitting.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    // With no output, rootDir is only the program boundary and can cover test/ and scripts/.
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // `scripts/` is included: they are dev-time tools, but they are load-bearing enough that
  // a broken one should be found by typecheck instead of at runtime.
  "include": ["src", "test", "scripts", "vitest.setup.ts", "vitest.config.ts"],
  "exclude": ["src/client/**", "**/node_modules", "**/.*/"]
}
