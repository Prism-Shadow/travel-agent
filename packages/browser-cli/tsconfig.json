{
  // 自包含：并入 travel-agent 后不再 extends 仓库根的 tsconfig.base.json。
  // travel-agent 的基线是 Bundler + noEmit（给 web/server 用），与本包需要的
  // NodeNext + composite + 真实 emit 不兼容，因此把原 penguin-browser 的基线
  // 设置内联到这里。见 packages/browser-cli/VENDOR.md。
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": false,
    "composite": true,
    // 刻意不含 dom：本包用 src/test-declarations.ts 给 evaluate() 回调提供宽松的
    // `var window: any` / `var document: any`，加入真实 DOM 会与之冲突。保持上游选择。
    "lib": ["es2024", "es2022", "es2017", "es7", "es6"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    // 上游基线里的 "jsx": "react-jsx" 已移除：本包无 .tsx 文件，该选项只会让 TS 去解析
    // react/jsx-runtime，把 @types/react 的 DOM 空桩拖进类型图。
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node", "chrome"]
  },
  "include": ["src"],
  "exclude": [
    // 浏览器上下文的客户端 bundle：由 esbuild 单独打成 IIFE 注入页面，不参与本包的 tsc
    // 编译（它们用 DOM 全局，而本包刻意不含 dom lib）。
    "src/a11y-client.ts",
    "src/ghost-cursor-client.ts",
    "src/help-overlay-client.ts",
    "**/node_modules",
    "**/.*/"
  ]
}
