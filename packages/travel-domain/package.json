{
  "name": "@travel-agent/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Travel domain logic: intents, and turning a search result set into the three or four options a person can actually decide between.",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
